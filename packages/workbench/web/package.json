{
  "name": "@agentry/workbench-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Agentry Workbench web half — a React + Vite SPA that `vite build`s into the committed plugin payload at plugin/workbench/web/ (the server static-serves it). Phase 0 is a placeholder shell proving the Vite artifact + dist-lockstep (ADR-003); the real router/sidebar/tabs land in Phase 1.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"import('node:fs').then(({writeFileSync})=>import('../../../scripts/lib/src-hash.mjs').then(({bundleSrcHash})=>writeFileSync('../../../plugin/workbench/web/.srchash',bundleSrcHash('..',{srcSubdir:'web/src',skipWorkspaceDeps:true}))))\"",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/test/**/*.test.ts'"
  },
  "dependencies": {
    "@agentry/workbench-shared": "workspace:*",
    "@codemirror/lang-markdown": "^6.5.1",
    "@dagrejs/dagre": "^3.1.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.2",
    "markdown-it": "^15.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
