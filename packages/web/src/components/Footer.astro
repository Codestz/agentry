---
// Footer.astro — the calm, muted site close (VISION §4.9 + the §1 meta-proof + §8 honesty).
// Carries: the truthful "built with /agentry:go — conducted end-to-end" line (the dogfood proof),
// a small seeded constellation mark (§5 motif), the key links, and the v0.1 / pre-1.0 / MIT note.
//
// Base-path rule: internal links (home, install anchor, dashboard) go through the shared
// withBase() helper; the in-page #install anchor stays bare; GitHub is absolute external. The
// dashboard is a real static artifact copied to public/dashboard/ at build (§7), at withBase('dashboard/').
import { withBase } from "../lib/base.ts";
const GITHUB = "https://github.com/Codestz/agentry";
const dashboard = withBase("dashboard/");
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <!-- Brand row: seeded mark + the meta-proof line. -->
    <div class="lead">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 28 28" width="24" height="24" role="img" focusable="false">
          <g stroke="url(#footEdge)" stroke-width="1" fill="none" opacity="0.6">
            <line x1="6" y1="9" x2="14" y2="5" />
            <line x1="14" y1="5" x2="22" y2="10" />
            <line x1="6" y1="9" x2="11" y2="18" />
            <line x1="11" y1="18" x2="22" y2="10" />
            <line x1="11" y1="18" x2="20" y2="22" />
            <line x1="22" y1="10" x2="20" y2="22" />
          </g>
          <g>
            <circle cx="14" cy="5" r="2.4" fill="var(--amber)" />
            <circle cx="6" cy="9" r="1.7" fill="var(--violet-2)" />
            <circle cx="22" cy="10" r="1.9" fill="var(--violet)" />
            <circle cx="11" cy="18" r="1.7" fill="var(--violet-2)" />
            <circle cx="20" cy="22" r="1.6" fill="var(--violet)" />
          </g>
          <defs>
            <linearGradient id="footEdge" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="var(--amber)" />
              <stop offset="1" stop-color="var(--violet)" />
            </linearGradient>
          </defs>
        </svg>
      </span>
      <p class="proof">
        Built with <code>/agentry:go</code> — conducted end&#8209;to&#8209;end.
        This site is the dogfood.
      </p>
    </div>

    <!-- Link set: GitHub (external), Install (in-page anchor), the live dashboard (real artifact). -->
    <nav class="links" aria-label="Footer">
      <a href={GITHUB} target="_blank" rel="noopener noreferrer">
        GitHub <span class="ext" aria-hidden="true">↗</span>
      </a>
      <a href="#install">Install</a>
      <a href={dashboard}>Dashboard</a>
    </nav>

    <!-- Honesty note (§8) + copyright. Muted, no boast. -->
    <div class="meta">
      <p class="note">
        <span class="badge">v0.1</span>
        <span class="sep" aria-hidden="true">·</span>
        Pre&#8209;1.0, MIT&#8209;licensed, live and measured — not asserted.
      </p>
      <p class="copy">© {year} Agentry</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    /* darker than the page canvas so the close reads as a distinct, settled band */
    background: var(--bg-2);
    padding-block: 56px;
    color: var(--muted);
  }

  .inner {
    display: grid;
    /* lead (proof) takes the room; links + meta sit to the right */
    grid-template-columns: 1.4fr 1fr;
    gap: 32px 48px;
    align-items: start;
  }

  /* Lead: mark + proof line ---------------------------------------------- */
  .lead {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 46ch;
  }

  .mark {
    flex: none;
    margin-top: 2px;
    filter: drop-shadow(0 0 5px rgba(244, 169, 60, 0.2));
  }

  .proof {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }

  .proof code {
    color: var(--violet-2);
    background: var(--violet-dim);
    padding: 1px 6px;
    border-radius: 6px;
  }

  /* Links ---------------------------------------------------------------- */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    /* align to the right column on wide screens */
    justify-content: flex-start;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 4px;
    font-size: 14.5px;
    color: var(--muted);
    transition: color 0.18s ease;
  }

  .links a:hover {
    color: var(--ink);
  }

  .ext {
    font-size: 0.85em;
    color: var(--faint);
  }

  /* Meta: honesty note + copyright -------------------------------------- */
  .meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 8px;
    padding-top: 24px;
    border-top: 1px solid var(--line-soft);
  }

  .note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    /* readable body copy (the honesty note) — --muted clears WCAG AA on --bg-2;
       --faint (3.27:1) is reserved for decorative micro-labels, not prose (AC5 a11y). */
    color: var(--muted);
  }

  .badge {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .sep {
    color: var(--line);
  }

  .copy {
    font-size: 13px;
    /* copyright is real text — --muted for WCAG AA on the --bg-2 footer (AC5 a11y). */
    color: var(--muted);
  }

  /* Responsive: stack into one column < 720px (links/meta below the proof). */
  @media (max-width: 720px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
