---
// DocsNav.astro — the shared docs sub-nav so the four concept pages + the overview
// read as one coherent section. A "← Docs" back-link to the overview, then the four
// concept links; the current page is marked aria-current and styled as active.
//
// Base-path rule (the #1 failure mode): every internal href goes through the shared
// withBase() helper or it 404s under /agentry. The `current` prop (a route key) drives
// the active state; no JS needed.
import { withBase } from "../lib/base.ts";

interface Props {
  /** The current concept route key — marks the matching link active. Omit on /docs. */
  current?: "flow" | "workbench" | "channels" | "memory";
}
const { current } = Astro.props;

// On the overview (/docs) no concept link is current, so the "← Docs" back-link is the
// "you are here" target. Mark it active (and aria-current) instead of leaving it a bare
// self-link with no state — the tiny cosmetic fix the plan calls for.
const onDocsIndex = current === undefined;

// The four concept pages, in the layering order the overview tells the story in:
// the mandatory substrate first (flow, memory), then the additive layers (workbench, channels).
const links = [
  { key: "flow", href: "docs/flow", label: "Flow" },
  { key: "memory", href: "docs/memory", label: "Memory" },
  { key: "workbench", href: "docs/workbench", label: "Workbench" },
  { key: "channels", href: "docs/channels", label: "Channels" },
] as const;
---

<nav class="docsnav" aria-label="Documentation">
  <a
    class:list={["docsnav__back", { "is-active": onDocsIndex }]}
    href={withBase("docs")}
    aria-current={onDocsIndex ? "page" : undefined}
  >
    <span class="docsnav__arrow" aria-hidden="true">←</span> Docs
  </a>
  <ul class="docsnav__links" role="list">
    {
      links.map((l) => (
        <li>
          <a
            href={withBase(l.href)}
            class:list={["docsnav__link", { "is-active": l.key === current }]}
            aria-current={l.key === current ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* a calm sticky sub-bar that sits under the site nav; glass over the canvas */
  .docsnav {
    position: sticky;
    top: 64px;
    z-index: 40;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-bottom: 8px;
    padding: 10px 0;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    backdrop-filter: blur(12px) saturate(120%);
  }

  .docsnav__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 10px;
    font-family: var(--mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--ink);
    border-radius: 8px;
    transition: background 0.18s ease;
  }

  .docsnav__back:hover {
    background: var(--violet-dim);
  }

  /* on /docs the back-link is "you are here": amber spark, same brand cue as the active concept link */
  .docsnav__back.is-active {
    color: var(--ink);
  }

  .docsnav__back.is-active .docsnav__arrow {
    color: var(--amber);
  }

  .docsnav__arrow {
    color: var(--faint);
  }

  .docsnav__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px;
    margin-left: auto;
  }

  .docsnav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 8px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--muted);
    transition: color 0.18s ease, background 0.18s ease;
  }

  .docsnav__link:hover {
    color: var(--ink);
    background: var(--violet-dim);
  }

  /* active page: amber spark marks "you are here" (brand, not action) */
  .docsnav__link.is-active {
    color: var(--ink);
  }

  .docsnav__link.is-active::before {
    content: "";
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--amber);
  }

  @media (max-width: 560px) {
    .docsnav__links {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
