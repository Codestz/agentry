---
// The one landing page (T8 — composition root). Pure composition: imports Base + the seven
// section components and renders them in IA order (VISION §4: claim → why → how → proof → install).
// No section logic, no styles of its own — every section owns its own markup, styles, and ids.
//
// Anchor integrity: Nav links to #proof, #how, #pillars, #install. The components already set
// #proof (Proof), #pillars (Pillars), and #install (Install). RoutingDemo ("how it works") does
// NOT carry an id, so its <RoutingDemo /> is wrapped here in <section id="how"> — the integration
// fix lives in the composition root, not in the component (other tasks' scope).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Pillars from '../components/Pillars.astro';
import RoutingDemo from '../components/RoutingDemo.astro';
import Moat from '../components/Moat.astro';
import Proof from '../components/Proof.astro';
import Install from '../components/Install.astro';
---

<Base
  title="Agentry — the agentic layer that measures itself"
  description="Agentry is an adaptive agentic layer for Claude Code: right-sized orchestration, SDLC specialists, and durable memory — that proves its work instead of asserting it."
>
  <Hero />
  <Why />
  <Pillars />
  <section id="how"><RoutingDemo /></section>
  <Moat />
  <Proof />
  <Install />
</Base>
