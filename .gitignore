# dependencies
node_modules/

# build output — all dev-only. The SHIPPED mem MCP bundle is built into plugin/mem/ (committed, zero-install).
packages/core/dist/
packages/memory/dist/

# derived memory index (text files are the source of truth and ARE committed; the DB is rebuilt)
**/.agentry/memory/**/*.db
**/.agentry/memory/**/*.db-shm
**/.agentry/memory/**/*.db-wal

# misc
*.log
.DS_Store
.idea/
.vscode/
*.tsbuildinfo

#agentry
.agentry

# local-only (not part of the shipped plugin; design docs stay private for now)
.agents/
skills-lock.json
.docs/

# self-eval run artifacts — per-run capture trees (config/events/summary/tasks); regenerated, never committed
packages/eval/runs/
# self-eval generated dashboards — `selfeval report <id>` output; regenerable from a run, carries a generatedAt stamp
packages/eval/results/
